[Unit]
Description=Huawei CGN NAT UDP Collector
Wants=network-online.target clickhouse-server.service
After=network-online.target clickhouse-server.service

[Service]
Type=simple
User=huawei-cgn
Group=huawei-cgn
WorkingDirectory=/opt/huawei-cgn-go
EnvironmentFile=/etc/huawei-cgn-go/huawei-cgn-go.env
ExecStartPre=/usr/bin/mkdir -p -m 0750 /index2/huawei-cgn-go/failed/open
ExecStartPre=/usr/bin/mkdir -p -m 0750 /index2/huawei-cgn-go/failed/done
ExecStartPre=/usr/bin/mkdir -p -m 0750 /index2/huawei-cgn-go/alerts/outbox
ExecStartPre=/usr/bin/mkdir -p -m 0750 /index2/huawei-cgn-go/alerts/bad
ExecStart=/opt/huawei-cgn-go/bin/huawei-cgn-go

Restart=always
RestartSec=5s
KillSignal=SIGTERM
TimeoutStopSec=15min

LimitNOFILE=1048576
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=-/index2/huawei-cgn-go/failed -/index2/huawei-cgn-go/alerts

StandardOutput=journal
StandardError=journal
SyslogIdentifier=huawei-cgn-go

[Install]
WantedBy=multi-user.target
