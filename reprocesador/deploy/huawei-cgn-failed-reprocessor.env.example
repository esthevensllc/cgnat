# El servicio tambien carga /etc/huawei-cgn-go/huawei-cgn-go.env para reutilizar
# CLICKHOUSE_URL, CLICKHOUSE_USER, CLICKHOUSE_PASS y FAILED_SPOOL_BASE.

# Mantener bajo al inicio para no competir con la insercion en vivo.
REPROCESS_WORKERS=1
REPROCESS_POLL_SECONDS=30
REPROCESS_MIN_AGE_SECONDS=60
REPROCESS_SCAN_LIMIT=1000

REPROCESS_MAX_RETRIES=3
REPROCESS_RETRY_MS=1000
REPROCESS_HTTP_TIMEOUT_SECONDS=180
REPROCESS_INTER_BATCH_DELAY_MS=250

# true crea la tabla diaria ausente con el mismo esquema del collector.
REPROCESS_AUTO_CREATE_TABLE=true

# delete elimina el RowBinary y su JSON solo despues de un INSERT exitoso.
# archive los mueve a FAILED_SPOOL_BASE/reprocessed para revision manual.
REPROCESS_SUCCESS_ACTION=delete

# Evita seguir redirecciones HTTP que podrian enviar credenciales a otro host.
REPROCESS_ALLOW_HTTP_REDIRECT=false

# Alertas del reproceso. Si REPROCESS_ALERTS_ENABLED no se define, hereda
# ALERTS_ENABLED del collector. Usa la misma tabla ClickHouse de alertas,
# pero un estado y outbox independientes dentro de FAILED_SPOOL_BASE.
REPROCESS_ALERTS_ENABLED=true
REPROCESS_ALERTS_MODE=clickhouse
# REPROCESS_ALERT_SERVER_IP hereda ALERT_SERVER_IP si se deja vacio.
# REPROCESS_ALERT_SERVER_IP=10.96.167.132
REPROCESS_ALERT_STATE_DIR=/index2/huawei-cgn-go/failed/alerts

# Se alerta cuando uno o mas lotes que cumplen la edad minima permanecen
# pendientes por 5 minutos o mas. Los porcentajes se calculan por lote.
REPROCESS_ALERT_EVALUATION_INTERVAL_SECONDS=10
REPROCESS_ALERT_WINDOW_SECONDS=60
REPROCESS_ALERT_BACKLOG_SLA_SECONDS=300
REPROCESS_ALERT_MIN_BATCHES=1
REPROCESS_ALERT_TRIGGER_WINDOWS=1
REPROCESS_ALERT_CLEAR_WINDOWS=3
REPROCESS_ALERT_ACTIVE_UPDATE_SECONDS=60
REPROCESS_ALERT_BACKLOG_THRESHOLD_PCT=1
REPROCESS_ALERT_BACKLOG_CLEAR_PCT=0.01
REPROCESS_ALERT_FAILURE_THRESHOLD_PCT=1
REPROCESS_ALERT_FAILURE_CLEAR_PCT=0.01
REPROCESS_ALERT_QUARANTINE_THRESHOLD_PCT=1
REPROCESS_ALERT_QUARANTINE_CLEAR_PCT=0.01

# Opcional. Si se omite, usa CLICKHOUSE_ALERT_TABLE del entorno del collector.
# REPROCESS_CLICKHOUSE_ALERT_TABLE=cgnat.collector_alerts
