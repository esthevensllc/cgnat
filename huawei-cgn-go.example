LISTEN_ADDR=0.0.0.0:9088

CLICKHOUSE_URL=http://CLICKHOUSE_HOST:8123
CLICKHOUSE_USER=REEMPLAZAR_USUARIO
CLICKHOUSE_PASS=REEMPLAZAR_CONTRASENA
CLICKHOUSE_TABLE=cgnat.huawei_cgn_nat_v2
CLICKHOUSE_DAILY_TABLES=true

RAW_SPOOL_BASE=/index2/huawei-cgn-go/raw
FAILED_SPOOL_BASE=/index2/huawei-cgn-go/failed
RAW_SPOOL_FORMAT=binary

MAX_EVENTS_PER_FILE=250000
MIN_EVENTS_PER_FILE=100000
ROTATE_SECONDS=10
FORCE_ROTATE_SECONDS=30
SYNC_EVERY_EVENTS=250000

UDP_READ_BUFFER_MB=512
UDP_RECEIVE_MODE=reuseport_bpf
UDP_RECEIVERS=16
UDP_REUSEPORT=true
# Offsets desde el inicio del payload UDP. En Huawei corresponden a campos
# variables del primer registro NAT, por lo que un router pesado se distribuye.
UDP_REUSEPORT_HASH_OFFSETS=20,36
UDP_BATCH_SIZE=128

PACKET_WORKERS=96
PACKET_CHANNEL_SIZE=1000000
RAW_CHANNEL_SIZE=500000

# Compatibilidad con versiones anteriores. En la version actual el batching
# live es directo en PACKET_WORKERS, por eso no existe una queue_event central.
EVENT_CHANNEL_SIZE=1000000

RAW_WRITERS=4
RAW_WRITER_BUFFER_MB=8

BATCH_BUILDERS=8
INSERT_WORKERS=12

INSERT_BATCH_ROWS=200000
INSERT_BATCH_BYTES=134217728
INSERT_FLUSH_MS=10000
INSERT_BATCH_CHANNEL_SIZE=512

INSERT_MAX_RETRIES=3
INSERT_RETRY_MS=500
INSERT_HTTP_TIMEOUT_SECONDS=180

# Ajuste dinamico bajo carga.
# Escala workers hacia arriba cuando las colas superan los porcentajes definidos.
AUTO_TUNE=true
AUTO_TUNE_INTERVAL_SECONDS=5
AUTO_TUNE_HIGH_WATERMARK_PCT=70
AUTO_TUNE_CRITICAL_WATERMARK_PCT=90
AUTO_TUNE_MAX_RAW_WRITERS=8
AUTO_TUNE_MAX_PACKET_WORKERS=192
AUTO_TUNE_MAX_BATCH_BUILDERS=16
AUTO_TUNE_MAX_INSERT_WORKERS=24

# Protege la recepcion UDP si la insercion en vivo no alcanza.
# raw_only guarda el lote RowBinary en FAILED_SPOOL_BASE cuando la cola live esta en zona roja.
# block mantiene el comportamiento anterior: espera a la insercion live aunque pueda llenar el socket UDP.
LIVE_INSERT_OVERLOAD_POLICY=raw_only
LIVE_INSERT_QUEUE_HIGH_WATERMARK_PCT=95
LIVE_INSERT_SEND_TIMEOUT_MS=1

# Alertas. Primero usar observe durante 24-48 horas. En este modo se calculan
# y registran en journald, pero no se abre ninguna conexion a Oracle.
ALERTS_ENABLED=false
ALERTS_MODE=observe
ALERT_SERVER_IP=10.0.0.1
ALERT_STATE_DIR=/index2/huawei-cgn-go/alerts

ALERT_EVALUATION_INTERVAL_SECONDS=10
ALERT_WINDOW_SECONDS=60
ALERT_SLA_SECONDS=60
ALERT_MIN_PACKETS=1000
ALERT_MIN_ROWS=1000
ALERT_TRIGGER_WINDOWS=1
ALERT_CLEAR_WINDOWS=3
ALERT_ACTIVE_UPDATE_SECONDS=60

# Porcentajes. Un valor 0.1 significa 0.1%, no 10%.
ALERT_UDP_DROP_THRESHOLD_PCT=0.1
ALERT_UDP_DROP_CLEAR_PCT=0.01
ALERT_PARSE_THRESHOLD_PCT=1
ALERT_PARSE_CLEAR_PCT=0.1
ALERT_INSERT_THRESHOLD_PCT=1
ALERT_INSERT_CLEAR_PCT=0.1

# Requerido solo con ALERTS_MODE=oracle.
ORACLE_ALERT_HOST=ORACLE_HOST
ORACLE_ALERT_PORT=1521
ORACLE_ALERT_SERVICE=ORACLE_SERVICE_NAME
ORACLE_ALERT_USER=REEMPLAZAR_USUARIO
ORACLE_ALERT_PASS=REEMPLAZAR_CONTRASENA
ORACLE_ALERT_TABLE=CGNAT.COLLECTOR_ALERTS
ORACLE_ALERT_CONNECT_TIMEOUT_SECONDS=5
ORACLE_ALERT_OPERATION_TIMEOUT_SECONDS=10
ORACLE_ALERT_RETRY_SECONDS=5
ORACLE_ALERT_MAX_RETRY_SECONDS=300
